<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.personalradar.agent</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec '__RADAR_INSTALL_DIR__/run-agent.sh'</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>RADAR_SOURCE_ROOT</key>
    <string>__RADAR_SOURCE_ROOT__</string>
    <key>RADAR_AGENT_RUNTIME</key>
    <string>__RADAR_INSTALL_DIR__/agent-runtime</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>600</integer>

  <key>StandardOutPath</key>
  <string>__RADAR_LOG_PATH__</string>
  <key>StandardErrorPath</key>
  <string>__RADAR_LOG_PATH__</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
